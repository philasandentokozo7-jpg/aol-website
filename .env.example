# Variable names only — never commit secrets or real API keys.
# Do not set any variable to a director personal name, ID number, tax number,
# residential address, or other private information.

# staging | production
NEXT_PUBLIC_SITE_MODE=

# Set true only after official domain is live and launch QA is complete
NEXT_PUBLIC_INDEXING_ENABLED=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_OFFICIAL_SITE_URL=
NEXT_PUBLIC_PREVIEW_SITE_URL=

NEXT_PUBLIC_REGISTERED_COMPANY_NAME=
NEXT_PUBLIC_TRADING_NAME=
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_VAT_STATUS=
NEXT_PUBLIC_VAT_REGISTERED=

NEXT_PUBLIC_PHYSICAL_ADDRESS=
NEXT_PUBLIC_POSTAL_ADDRESS=

NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_URL=

# Approved public addresses (defaults in src/config/site.ts):
# info@aolaccountants.co.za — general enquiries
# accounts@aolaccountants.co.za — accounts and billing
# privacy@aolaccountants.co.za — privacy / POPIA / Information Officer
# office@aolaccountants.co.za — office contact
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ACCOUNTS_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_OFFICE_EMAIL=
NEXT_PUBLIC_FUTURE_DOMAIN_EMAIL=
NEXT_PUBLIC_COMPLAINTS_EMAIL=

# Public designation only — e.g. Director of AOL Accounting Academy SA
NEXT_PUBLIC_INFORMATION_OFFICER_TITLE=
NEXT_PUBLIC_INFORMATION_OFFICER_EMAIL=

NEXT_PUBLIC_BUSINESS_HOURS=

NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

NEXT_PUBLIC_XERO_PUBLIC_STATEMENT=
NEXT_PUBLIC_SUPPORTING_DOCUMENTS_STATEMENT=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_POLICY_EFFECTIVE_DATE=

# Enquiry form uses Netlify Forms (name: aol-website-enquiries).
# Form submissions do not POST to an email address.
# Configure Netlify dashboard form notifications to: office@aolaccountants.co.za
# (dashboard setting only — not a client-side form-routing variable).
