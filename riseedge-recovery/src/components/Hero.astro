---
import { Image } from 'astro:assets';
import heroImg from '../assets/car-hero.png';
import { buildWhatsAppUrl, buildQuoteMessage } from '../lib/whatsapp';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'Durban · KwaZulu-Natal',
  title,
  subtitle,
  primaryLabel = 'Get a Quote on WhatsApp',
  primaryHref = buildWhatsAppUrl(buildQuoteMessage({ service: 'General enquiry' })),
  secondaryLabel = 'View Services',
  secondaryHref = '#services',
} = Astro.props;

const isWhatsApp = primaryHref.startsWith('https://wa.me');
---

<section class="relative isolate overflow-hidden">
  <!-- Cinematic hero image: optimized WebP, eager, responsive. Dark navy scrim. -->
  <div class="scrim absolute inset-0 -z-10">
    <Image
      src={heroImg}
      alt="RiseEdge Transport 7-seater at night on a wet Durban road"
      widths={[480, 768, 1200, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="media h-full w-full"
      style="object-position: 60% 50%;"
    />
  </div>
  <div class="route-glow -z-10"></div>

  <!-- Signature: glowing Durban route-line -->
  <svg
    class="pointer-events-none absolute right-0 top-8 -z-10 hidden w-[520px] max-w-[55%] opacity-70 lg:block"
    viewBox="0 0 520 320"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M16 296 C 150 296, 150 168, 252 168 S 410 56, 504 56"
      stroke="url(#hg)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-dasharray="3 11"
      class="route-anim"
    />
    <defs>
      <linearGradient id="hg" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#2b83ff" stop-opacity="0.2" />
        <stop offset="0.6" stop-color="#2b83ff" />
        <stop offset="1" stop-color="#d8b26a" />
      </linearGradient>
    </defs>
    <circle cx="16" cy="296" r="6" fill="#2b83ff" />
    <circle cx="252" cy="168" r="5" fill="#9db0cc" />
    <circle cx="504" cy="56" r="6" fill="#d8b26a" />
  </svg>

  <div class="container-tight relative grid min-h-[88svh] items-center py-20 sm:min-h-[82svh] sm:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow hero-rise" style="animation-delay: 0ms;">{eyebrow}</p>

      <h1
        class="hero-rise mt-6 text-balance font-display font-semibold"
        style="animation-delay: 90ms; font-size: var(--step-5); line-height: 0.98; letter-spacing: -0.035em;"
      >
        {title}
      </h1>

      <p
        class="hero-rise mt-6 max-w-xl text-pretty text-muted"
        style="animation-delay: 180ms; font-size: var(--step-1); color: var(--muted);"
      >
        {subtitle}
      </p>

      <div class="hero-rise mt-9 flex flex-col gap-3 sm:flex-row" style="animation-delay: 270ms;">
        <a
          href={primaryHref}
          target={isWhatsApp ? '_blank' : undefined}
          rel={isWhatsApp ? 'noopener' : undefined}
          class="btn btn-primary"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm4.52 11.86c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.38-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z" />
          </svg>
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
      </div>

      <p class="hero-rise mt-5 t-small" style="animation-delay: 360ms; color: var(--muted-dim);">
        No app needed. Tap, message us on WhatsApp, get your price.
      </p>

      <ul class="hero-rise mt-7 flex flex-wrap gap-2" style="animation-delay: 430ms;">
        {['On-time pickups', 'Clean 7-seater', 'Professional driver', 'Price confirmed upfront'].map((c) => (
          <li class="rounded-full border border-[var(--line-strong)] bg-white/[0.05] px-3.5 py-1.5 t-small font-medium text-white/90 backdrop-blur-sm">{c}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- bottom hairline into the page -->
  <div class="rule absolute inset-x-0 bottom-0"></div>
</section>
